---
import { ASSET_VERSION } from "../lib/assets";
import Footer from "../components/Footer.astro";
import { ogImageUrl } from "../lib/og";
import QuestShell from "./QuestShell.astro";

interface Props {
  title: string;
  description: string;
  canonical: string;
  type: "post" | "writeup";
  mermaid?: boolean;
  jsonLd?: Record<string, unknown> | null;
}

const { title, description, canonical, type, mermaid = false, jsonLd = null } = Astro.props;
const articleOgImage = ogImageUrl(canonical);
const articleOgImageAlt = `Cover image for ${title}`;
---
<QuestShell
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  ogImage={articleOgImage}
  ogImageAlt={articleOgImageAlt}
  ogImageWidth={1200}
  ogImageHeight={630}
  viewport="width=device-width, initial-scale=1.0"
  spa={true}
  brandHref="/"
  pageLinkPrefix="/pages/"
  bodyClass={type === "writeup" ? "writeup-document content-document" : "content-document"}
  disablePageLoader={type === "writeup"}
  mermaid={mermaid}
  jsonLd={jsonLd}
  preloadFonts={[
    "/assets/fonts/press-start/press-start-k.woff2",
    "/assets/fonts/sf-pixelate/sf-pixelate-bold.woff2",
  ]}
>
  <script type="module" src={`/assets/js/astro-article.js?v=${ASSET_VERSION}`} is:inline></script>
  <slot />
  <Footer heading={type === "post" ? "BLOG STATUS" : "CONNECT"} stats={type === "post"} />
</QuestShell>
