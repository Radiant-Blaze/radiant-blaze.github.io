---
import Footer from "../components/Footer.astro";
import QuestShell from "./QuestShell.astro";

interface Props {
  title: string;
  description: string;
  canonical: string;
  type: "post" | "writeup";
}

const { title, description, canonical, type } = Astro.props;
---
<QuestShell
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  viewport="width=device-width, initial-scale=1.0"
  cssVersion="20261002-15"
  spa={false}
  brandHref="/"
  pageLinkPrefix="/pages/"
>
  <script slot="headScripts" type="module" src="/assets/js/astro-article.js?v=20261002-1" is:inline></script>
  <slot />
  <Footer heading={type === "post" ? "BLOG STATUS" : "CONNECT"} stats={type === "post"} />
</QuestShell>
