---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogUrl?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  viewport?: string;
  currentPage?: "blog" | "ctf" | "search";
  cssVersion?: string;
  audio?: boolean;
  spa?: boolean;
  brandHref?: string;
  pageLinkPrefix?: string;
}

const {
  title,
  description,
  canonical,
  ogUrl = canonical,
  ogTitle = title,
  ogDescription = description,
  ogType = "website",
  viewport = "width=device-width,initial-scale=1.0",
  currentPage,
  cssVersion = "20261002-15",
  audio = true,
  spa = true,
  brandHref = "../index.html",
  pageLinkPrefix = "",
} = Astro.props;
---
<!doctype html>
<html lang="en" class="dark-theme">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content={viewport} />
    <meta name="description" content={description} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#171329" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Radiant Blaze" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    <meta property="og:image" content="https://radiant-blaze.github.io/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content="https://radiant-blaze.github.io/og-image.png" />
    <link rel="preload" href="/assets/fonts/press-start-2p-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={`/assets/css/style.css?v=${cssVersion}`} />
    <script src="/assets/js/astro-controls.js" is:inline></script>
    <script src="/assets/js/page-loader.js" defer is:inline></script>
    {spa && <script defer src="/assets/js/astro-navigation.js" is:inline></script>}
    <slot name="headScripts" />
  </head>
  <body>
    <main class="quest-screen">
      <header class="quest-top quest-wrap site-header">
        <a class="quest-brand" href={brandHref}><span class="pixel-logo">RB</span><span class="brand-copy"><span class="brand-title">RADIANT BLAZE</span><span class="brand-caption">QUEST LOG / FIELD HQ</span></span></a>
        <div class="quest-nav-group">
          <nav class="quest-nav" id="primary-site-nav" aria-label="Blog navigation">
          <a href={`${pageLinkPrefix}blog.html`} data-nav-index="01" aria-current={currentPage === "blog" ? "page" : undefined}>BLOG</a><a href={`${pageLinkPrefix}ctf.html`} data-nav-index="02" aria-current={currentPage === "ctf" ? "page" : undefined}>CTFS</a><a href={`${pageLinkPrefix}search.html`} data-nav-index="03" aria-current={currentPage === "search" ? "page" : undefined}>SEARCH</a>
          </nav>
          <div class="top-controls quest-nav-tools">
          <input class="theme-checkbox" id="theme-toggle-checkbox" type="checkbox" data-theme-toggle aria-label="Switch to light theme" />
          <label class="theme-switch" for="theme-toggle-checkbox" aria-hidden="true"><span class="theme-switch-thumb"><svg class="sun-icon" viewBox="0 0 16 16"><path d="M7 0h2v3H7zM7 13h2v3H7zM0 7h3v2H0zM13 7h3v2h-3zM2 2h2v2H2zM12 2h2v2h-2zM2 12h2v2H2zM12 12h2v2h-2zM5 5h6v6H5z" /></svg><svg class="moon-icon" viewBox="0 0 24 24"><path d="M19.8 15.1A9.4 9.4 0 0 1 8.9 4.2 9.6 9.6 0 1 0 19.8 15.1Z" /><path d="M17 3v4M15 5h4M6 2v3M4.5 3.5h3M20 9v3M18.5 10.5h3" /></svg></span></label>
          {audio && <><input class="audio-checkbox" id="audio-toggle-checkbox" type="checkbox" data-audio-toggle aria-label="Play music" /><label class="toggleSwitch" for="audio-toggle-checkbox" aria-hidden="true"><span class="speaker"><svg viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3z" /><path d="M16 9a5 5 0 0 1 0 6m3-9a9 9 0 0 1 0 12" /></svg></span><span class="mute-speaker"><svg viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3z" /><path d="m16 9 5 6m0-6-5 6" /></svg></span></label></>}
          <button class="mobile-menu-toggle" data-mobile-menu-toggle type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="primary-site-nav">
            <span class="menu-wrapper" aria-hidden="true">
              <span class="menu-row menu-row-top"><span class="menu-dot"></span><span class="menu-dot"></span></span>
              <span class="menu-row menu-row-bottom"><span class="menu-dot"></span><span class="menu-dot"></span></span>
              <span class="menu-row menu-row-horizontal"><span class="menu-dot"></span><span class="menu-dot menu-dot-horizontal"></span><span class="menu-dot"></span></span>
              <span class="menu-row menu-row-vertical"><span class="menu-dot"></span><span class="menu-dot menu-dot-vertical"></span><span class="menu-dot"></span></span>
            </span>
          </button>
          </div>
        </div>
      </header>
      <slot />
    </main>
    <slot name="pageScripts" />
  </body>
</html>