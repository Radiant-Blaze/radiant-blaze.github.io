---
import { ASSET_VERSION } from "../lib/assets";
import ThemeBootstrap from "../components/ThemeBootstrap.astro";
import { DEFAULT_OG_IMAGE } from "../lib/og";
import { JSON_FEED_URL, RSS_FEED_URL, serializeJsonLd } from "../lib/seo";
import "../styles/style.css";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogUrl?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  viewport?: string;
  currentPage?: "blog" | "ctf" | "search" | "portfolio";
  spa?: boolean;
  brandHref?: string;
  pageLinkPrefix?: string;
  bodyClass?: string;
  /** Thin hubs stay readable but tell crawlers to follow without indexing. */
  noindex?: boolean;
  /** Document-style pages (writeups, portfolio) suppress the page loader overlay. */
  disablePageLoader?: boolean;
  mermaid?: boolean;
  preloadFonts?: string[];
  /** Structured data for the page head; serialized and escaped by the layout. */
  jsonLd?: Record<string, unknown> | null;
}

const {
  title,
  description,
  canonical,
  ogUrl = canonical,
  ogTitle = title,
  ogDescription = description,
  ogType = "website",
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = "Radiant Blaze pixel-art city banner",
  ogImageWidth = 1500,
  ogImageHeight = 592,
  viewport = "width=device-width,initial-scale=1.0",
  currentPage,
  spa = true,
  brandHref = "../index.html",
  pageLinkPrefix = "/pages/",
  disablePageLoader = false,
  bodyClass,
  noindex = false,
  mermaid = false,
  preloadFonts = [],
  jsonLd = null,
} = Astro.props;
---
<!doctype html>
<html lang="en" class="dark-theme">
  <head>
    <meta charset="UTF-8" />
    <ThemeBootstrap />
    <meta name="viewport" content={viewport} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#171329" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Radiant Blaze" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="alternate" type="application/rss+xml" title="Radiant Blaze — RSS feed" href={RSS_FEED_URL} />
    <link rel="alternate" type="application/feed+json" title="Radiant Blaze — JSON feed" href={JSON_FEED_URL} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={serializeJsonLd(jsonLd)} />}
    <link rel="preload" href="/assets/fonts/press-start-2p-latin.woff2" as="font" type="font/woff2" crossorigin />
    {preloadFonts.map((font) => <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />)}
    <script src="../scripts/astro-controls.ts"></script>
    <script defer src={`/assets/js/music-controller.js?v=${ASSET_VERSION}`} is:inline></script>
    <script src="../scripts/page-loader.ts"></script>
    {spa && <script src="../scripts/astro-navigation.ts"></script>}
    <slot name="headScripts" />
  </head>
  <body class:list={[disablePageLoader && "disable-page-loader", bodyClass]}>
    <a class="skip-link" href="#main-content">SKIP TO CONTENT</a>
    <main class="quest-screen" id="main-content" tabindex="-1">
      <header class="quest-top quest-wrap site-header">
        <a class="quest-brand" href={brandHref}><span class="pixel-logo">RB</span><span class="brand-copy"><span class="brand-title">RADIANT BLAZE</span><span class="brand-caption">QUEST LOG / FIELD HQ</span></span></a>
        <div class="quest-nav-group">
          <nav class="quest-nav" id="primary-site-nav" aria-label="Primary site navigation">
          <a href={`${pageLinkPrefix}blog.html`} data-nav-index="01" aria-current={currentPage === "blog" ? "page" : undefined}>BLOG</a><a href={`${pageLinkPrefix}ctf.html`} data-nav-index="02" aria-current={currentPage === "ctf" ? "page" : undefined}>CTFS</a><a href={`${pageLinkPrefix}search.html`} data-nav-index="03" aria-current={currentPage === "search" ? "page" : undefined}>SEARCH</a><a href="/portfolio/" data-nav-index="04" aria-current={currentPage === "portfolio" ? "page" : undefined}>PORTFOLIO</a>
          </nav>
          <div class="top-controls quest-nav-tools">
          <input class="theme-checkbox" id="theme-toggle-checkbox" type="checkbox" data-theme-toggle aria-label="Switch to light theme" />
          <label class="theme-switch" for="theme-toggle-checkbox" aria-hidden="true"><span class="theme-switch-thumb"><svg class="sun-icon" viewBox="0 0 16 16"><path d="M7 0h2v3H7zM7 13h2v3H7zM0 7h3v2H0zM13 7h3v2h-3zM2 2h2v2H2zM12 2h2v2h-2zM2 12h2v2H2zM12 12h2v2h-2zM5 5h6v6H5z" /></svg><svg class="moon-icon" viewBox="0 0 24 24"><path d="M19.8 15.1A9.4 9.4 0 0 1 8.9 4.2 9.6 9.6 0 1 0 19.8 15.1Z" /><path d="M17 3v4M15 5h4M6 2v3M4.5 3.5h3M20 9v3M18.5 10.5h3" /></svg></span></label>
          <button class="mobile-menu-toggle" data-mobile-menu-toggle type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="primary-site-nav">
            <span class="menu-wrapper" aria-hidden="true">
              <span class="menu-row menu-row-top"><span class="menu-dot"></span><span class="menu-dot"></span></span>
              <span class="menu-row menu-row-bottom"><span class="menu-dot"></span><span class="menu-dot"></span></span>
              <span class="menu-row menu-row-horizontal"><span class="menu-dot"></span><span class="menu-dot menu-dot-horizontal"></span><span class="menu-dot"></span></span>
              <span class="menu-row menu-row-vertical"><span class="menu-dot"></span><span class="menu-dot menu-dot-vertical"></span><span class="menu-dot"></span></span>
            </span>
          </button>
          </div>
        </div>
      </header>
      <slot />
      {mermaid && <script src="../scripts/mermaid-viewer.js"></script>}
    </main>
  </body>
</html>