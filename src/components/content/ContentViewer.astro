---
import ArticleShell from "../../layouts/ArticleShell.astro";
import ContentNavigation from "./ContentNavigation.astro";
import ContentTOC from "./ContentTOC.astro";

interface Props {
  title: string;
  description: string;
  canonical: string;
  type: "post" | "writeup";
  body: string;
  pagerHtml?: string;
  tocHtml: string;
  tocLabel: string;
  relatedHtml: string;
  relatedChallengesHtml?: string;
  relatedLabel: string;
  flagHtml?: string;
  layoutClass: string;
  sidebarClass: string;
  articleClass?: string;
  sidebarLabel: string;
  progressLabel?: string;
  showProgress?: boolean;
  mermaid?: boolean;
  jsonLd?: Record<string, unknown> | null;
}

const {
  title,
  description,
  canonical,
  type,
  body,
  pagerHtml = "",
  tocHtml,
  tocLabel,
  relatedHtml,
  relatedChallengesHtml = "",
  relatedLabel,
  flagHtml = "",
  layoutClass,
  sidebarClass,
  articleClass,
  sidebarLabel,
  progressLabel = "ARTICLE",
  showProgress = true,
  mermaid = false,
  jsonLd = null,
} = Astro.props;
---
<ArticleShell {title} {description} {canonical} {type} {mermaid} {jsonLd}>
  <slot name="before" />
  <slot name="header" />
  <div class:list={[layoutClass, "content-layout", "quest-wrap"]}>
    <article class:list={["quest-article", "content-article", articleClass]} data-content-article>
      <Fragment set:html={body} />
      {pagerHtml && <Fragment set:html={pagerHtml} />}
      <Fragment set:html={flagHtml} />
      <ContentNavigation label={relatedLabel} html={relatedHtml} />
      {relatedChallengesHtml && <Fragment set:html={relatedChallengesHtml} />}
    </article>
    <aside class:list={["content-sidebar", sidebarClass]} aria-label={sidebarLabel}>
      {showProgress && (
        <section class="pixel-panel content-progress">
          <div class="hp-label"><span>READING PROGRESS</span><span>{progressLabel}</span></div>
          <div class="hp-track"><span class="hp-fill" data-hp></span></div>
        </section>
      )}
      <ContentTOC html={tocHtml} label={tocLabel} />
      <slot name="sidebar" />
    </aside>
  </div>
</ArticleShell>
