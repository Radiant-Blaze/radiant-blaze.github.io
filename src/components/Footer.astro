---
import site from "../../content/site.json";
import { socialLinksHtml } from "../lib/listing-html";
import { getRuntimeReadModel } from "../lib/runtime-read-model";
import { calculatePlayerStats } from "../lib/player-stats";

interface Props {
  heading?: string;
  stats?: boolean;
  home?: boolean;
  simple?: boolean;
}

const { heading = "CONNECT", stats: showStats = false, home = false, simple = false } = Astro.props;
const year = new Date().getFullYear();
// Real counters, derived from the published content index at build time. The
// previous hardcoded block advertised 21 posts / 28,750 words / 1,284 readers
// while the site actually shipped 1 post and 22 writeups.
const footerStats = showStats ? calculatePlayerStats(await getRuntimeReadModel()) : null;
---
<footer class={home ? undefined : "site-footer"}>
  {simple ? <><span>© {year} RADIANT BLAZE</span><span>MADE WITH ♥ + PIXELS</span></> : <>
    <div class="quest-wrap footer-connect">
      <p class="section-heading">{heading}</p>
      {footerStats && <div class="footer-stats"><span><b>{footerStats.blogPosts}</b>POSTS</span><span><b>{footerStats.wordsWritten.toLocaleString("en-US")}</b>WORDS</span><span><b>{footerStats.writeups}</b>WRITEUPS</span><span><b>{footerStats.categories}</b>CATEGORIES</span></div>}
      <nav class="social-links" data-social aria-label="Social links" set:html={socialLinksHtml(site.social)}></nav>
    </div>
    {home && <div class="footer-meta"><span>© <span id="year">{year}</span> RADIANT BLAZE</span><span>MADE WITH ♥ + PIXELS</span></div>}
  </>}
</footer>
