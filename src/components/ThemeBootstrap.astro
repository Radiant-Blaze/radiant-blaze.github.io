{/* Runs before any stylesheet or module so the persisted theme paints on the
    first frame. This is the only place that reads the stored preference. */}
<script is:inline>
  (() => {
    const THEME_KEY = "radiant-blaze-theme";
    const root = document.documentElement;
    let theme = "dark";
    try {
      theme = localStorage.getItem(THEME_KEY) === "light" ? "light" : "dark";
    } catch (error) {
      console.warn("[radiant-blaze] Theme preference could not be read.", error);
    }
    root.classList.toggle("light-theme", theme === "light");
    root.classList.toggle("dark-theme", theme === "dark");
  })();
</script>
