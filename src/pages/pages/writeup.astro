---
import QuestShell from "../../layouts/QuestShell.astro";
import Footer from "../../components/Footer.astro";
---
<QuestShell
  title="Writeup · Radiant Blaze"
  description="Read a capture-the-flag challenge write-up on Radiant Blaze."
  ogTitle="CTF Writeup · Radiant Blaze"
  ogType="article"
  ogUrl="https://radiant-blaze.github.io/pages/writeup.html"
  cssVersion="20261002-15"
  viewport="width=device-width, initial-scale=1.0"
>
  <p class="ctf-back quest-wrap" data-writeup-back></p>
  <header class="article-header quest-wrap" data-writeup-header><p class="quest-number">LOADING WRITEUP...</p></header>
  <div class="page-grid article-layout quest-wrap">
    <article class="quest-article" data-writeup><p>LOADING WRITEUP...</p></article>
  </div>
  <Footer />
</QuestShell>
<script slot="pageScripts" type="module" src="/assets/js/astro-pages.js?v=20261002-1" is:inline></script>
