---
// Compatibility shell for the retired /pages/writeup.html?ctf=&challenge= viewer.
// Static hosting cannot redirect query-string URLs, so this page resolves the
// legacy query at runtime and forwards to the generated Astro writeup route.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#171329" />
    <title>Writeup · Radiant Blaze</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      html { background: #171329; color: #e8e4ff; }
      body { display: grid; min-height: 100vh; margin: 0; place-items: center; font: 14px/1.7 system-ui, sans-serif; }
      main { width: min(100% - 40px, 420px); padding: 24px; border: 3px solid #65e7e3; background: #221c38; box-shadow: 6px 6px 0 #0b0815; }
      a { color: #65e7e3; }
    </style>
    <script src="../../scripts/legacy-redirect.ts"></script>
  </head>
  <body data-legacy-redirect="writeup">
    <main>
      <p>Redirecting to the published writeup…</p>
      <p><a data-legacy-fallback href="/pages/ctf.html">Continue to the CTF arena</a></p>
    </main>
  </body>
</html>
