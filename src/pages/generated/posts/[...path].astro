---
import { getOrderedArticles, postRoute } from "../../../lib/article-data";
import { getPostPresentation } from "../../../lib/article-metadata";
import ContentHeader from "../../../components/content/ContentHeader.astro";
import ContentViewer from "../../../components/content/ContentViewer.astro";
import { renderContentView, renderTocHtml } from "../../../lib/content-view";
import { encodePath, escapeHtml, formatDate } from "../../../lib/markdown";

export async function getStaticPaths() {
  const { posts } = await getOrderedArticles();
  return posts.map(({ entry }) => ({
    params: { path: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const post = entry.data;
const { title, description, category, tags, author, estimatedPlayTime } = getPostPresentation(post);
const route = postRoute(entry.id);
const { html: body, headings } = await renderContentView(entry.body ?? "");
const hasMermaid = body.includes('data-language="mermaid"');
const tocHtml = renderTocHtml(headings, "This article has no section headings.");
const related = [
  `<a href="/pages/blog.html?category=${encodePath(category)}">MORE ${escapeHtml(category).toUpperCase()} POSTS</a>`,
  ...tags.slice(0, 2).map((tag) =>
    `<a href="/pages/search.html?topic=${encodePath(tag.toLowerCase())}">MORE ${escapeHtml(tag).toUpperCase()}</a>`,
  ),
].join("");
const tagsHtml = tags
  .map((tag) => `<a href="/pages/search.html?topic=${encodePath(tag.toLowerCase())}"># ${escapeHtml(tag).toUpperCase()}</a>`)
  .join("");
const tagsPanel = `<section class="pixel-panel"><h2>TAGS</h2><nav class="region-list">${tagsHtml}</nav></section>`;
---
<ContentViewer
  title={`${title} · Radiant Blaze`}
  description={description}
  canonical={`https://radiant-blaze.github.io${route}`}
  type="post"
  body={body}
  tocHtml={tocHtml}
  tocLabel="Article contents"
  relatedHtml={related}
  relatedLabel="Related content"
  layoutClass="page-grid article-layout"
  sidebarClass="sidebar"
  sidebarLabel="Article navigation and tags"
  mermaid={hasMermaid}
>
  <ContentHeader
    slot="header"
    title={title.toUpperCase()}
    headerClass="article-header"
    titleClass="quest-title"
  >
    <p slot="eyebrow" class="quest-number">POST · {category.toUpperCase()}</p>
    <div slot="meta" class="article-info"><span>READ TIME: <b>{estimatedPlayTime.toUpperCase()}</b></span><span>{formatDate(post.date)}</span><span>BY <b>{author.toUpperCase()}</b></span></div>
  </ContentHeader>
  <Fragment slot="sidebar" set:html={tagsPanel} />
</ContentViewer>
