---
import { getOrderedArticles, postRoute } from "../../../lib/article-data";
import { getPostPresentation } from "../../../lib/article-metadata";
import ContentHeader from "../../../components/content/ContentHeader.astro";
import ContentViewer from "../../../components/content/ContentViewer.astro";
import { renderContentView, renderTocHtml } from "../../../lib/content-view";
import { encodePath, escapeHtml, formatDate } from "../../../lib/markdown";
import { ogImageUrl } from "../../../lib/og";
import { renderPostPager, selectPostNeighbors } from "../../../lib/post-pager.ts";
import { getRuntimeReadModel } from "../../../lib/runtime-read-model";
import { collectTopics, TOPICS_INDEX_ROUTE, topicRoute } from "../../../lib/topics";
import {
  articleEntity,
  breadcrumbEntity,
  isoDate,
  jsonLdGraph,
  personEntity,
  SITE_DESCRIPTION,
  webPageEntity,
  websiteEntity,
} from "../../../lib/seo";

export async function getStaticPaths() {
  const { posts } = await getOrderedArticles();
  const pagerItems = posts.map(({ entry }) => ({
    id: entry.id,
    title: getPostPresentation(entry.data).title,
    href: postRoute(entry.id),
  }));
  const topicRoutes = Object.fromEntries(
    collectTopics(await getRuntimeReadModel()).map((topic) => [
      topic.label.toLowerCase(),
      topicRoute(topic.slug),
    ]),
  );

  return posts.map(({ entry }) => ({
    params: { path: entry.id },
    props: { entry, ...selectPostNeighbors(pagerItems, entry.id), topicRoutes },
  }));
}

const { entry, newer, older, topicRoutes } = Astro.props;
const post = entry.data;
const { title, description, category, tags, author, estimatedPlayTime } = getPostPresentation(post);
const route = postRoute(entry.id);
const url = `https://radiant-blaze.github.io${route}`;
const jsonLd = jsonLdGraph(
  personEntity(),
  websiteEntity(SITE_DESCRIPTION),
  webPageEntity({ name: title, description, url }),
  breadcrumbEntity([
    { name: "Home", path: "/" },
    { name: "Blog", path: "/pages/blog.html" },
    { name: title, path: route },
  ]),
  articleEntity({
    type: "BlogPosting",
    headline: title,
    description,
    url,
    datePublished: isoDate(post.date),
    articleSection: category,
    keywords: tags,
    image: ogImageUrl(url),
  }),
);
const { html: body, headings } = await renderContentView(entry.body ?? "");
const pagerHtml = renderPostPager({ newer, older });
const hasMermaid = body.includes('data-language="mermaid"');
const tocHtml = renderTocHtml(headings, "This article has no section headings.");
const tagHref = (tag: string) =>
  (topicRoutes as Record<string, string>)[tag.trim().toLowerCase()] ?? TOPICS_INDEX_ROUTE;
const related = [
  `<a href="/pages/blog.html?category=${encodePath(category)}">MORE ${escapeHtml(category).toUpperCase()} POSTS</a>`,
  ...tags.slice(0, 2).map((tag) =>
    `<a href="${tagHref(tag)}">MORE ${escapeHtml(tag).toUpperCase()}</a>`,
  ),
].join("");
const tagsHtml = tags
  .map((tag) => `<a href="${tagHref(tag)}"># ${escapeHtml(tag).toUpperCase()}</a>`)
  .join("");
const tagsPanel = `<section class="pixel-panel"><h2>TAGS</h2><nav class="region-list">${tagsHtml}</nav></section>`;
---
<ContentViewer
  title={`${title} · Radiant Blaze`}
  description={description}
  canonical={url}
  jsonLd={jsonLd}
  type="post"
  body={body}
  pagerHtml={pagerHtml}
  tocHtml={tocHtml}
  tocLabel="Article contents"
  relatedHtml={related}
  relatedLabel="Related content"
  layoutClass="page-grid article-layout"
  sidebarClass="sidebar"
  sidebarLabel="Article navigation and tags"
  mermaid={hasMermaid}
>
  <ContentHeader
    slot="header"
    title={title.toUpperCase()}
    headerClass="article-header"
    titleClass="quest-title"
  >
    <p slot="eyebrow" class="quest-number">POST · {category.toUpperCase()}</p>
    <div slot="meta" class="article-info"><span>READ TIME: <b>{estimatedPlayTime.toUpperCase()}</b></span><span>{formatDate(post.date)}</span><span>BY <b>{author.toUpperCase()}</b></span></div>
  </ContentHeader>
  <Fragment slot="sidebar" set:html={tagsPanel} />
</ContentViewer>
