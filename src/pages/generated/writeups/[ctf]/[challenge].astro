---
import { getOrderedArticles, type OrderedWriteup, writeupRoute } from "../../../../lib/article-data";
import { getWriteupPresentation } from "../../../../lib/article-metadata";
import ContentHeader from "../../../../components/content/ContentHeader.astro";
import ContentViewer from "../../../../components/content/ContentViewer.astro";
import { renderContentView, renderTocHtml } from "../../../../lib/content-view";
import { difficultyMeterHtml } from "../../../../lib/difficulty";
import { escapeHtml, formatDate } from "../../../../lib/markdown";

export async function getStaticPaths() {
  const { writeups } = await getOrderedArticles();
  return writeups.map((writeup: OrderedWriteup) => ({
    params: {
      ctf: writeup.ctfId,
      challenge: writeup.challengeFile.replace(/\.md$/i, ""),
    },
    props: {
      ...writeup,
      eventChallengeFiles: writeup.challengeFiles,
    },
  }));
}

const { ctfId, challengeFile, entry, event, eventChallengeFiles } = Astro.props;
const challenge = entry.data;
const eventTitle = event.data.title;
const {
  title,
  description,
  category,
  points: pointsText,
  difficulty,
  solves: solvesValue,
  flag: flagValue,
  tags: challengeTags,
  author,
} = getWriteupPresentation(challenge, challengeFile, eventTitle);
const route = writeupRoute(ctfId, challengeFile);
const challengeNumber = eventChallengeFiles.indexOf(challengeFile);
const previous = eventChallengeFiles[challengeNumber - 1];
const following = eventChallengeFiles[challengeNumber + 1];
const eventQuery = new URLSearchParams({ ctf: ctfId }).toString();
const challengeUrl = (file: string) => writeupRoute(ctfId, file);
const { html: body, headings } = await renderContentView(entry.body ?? "");
const tocHtml = renderTocHtml(headings, "This writeup has no section headings.");
const related = `${previous ? `<a href="${challengeUrl(previous)}">← PREVIOUS CHALLENGE</a>` : "<span>FIRST CHALLENGE</span>"}<span>CHALLENGE ${challengeNumber + 1} / ${eventChallengeFiles.length}</span>${following ? `<a href="${challengeUrl(following)}">NEXT CHALLENGE →</a>` : "<span>LAST CHALLENGE</span>"}`;
const tagsForEvent = challengeTags
  .map((tag) => `<a href="/pages/ctf.html?${eventQuery}"># ${escapeHtml(tag)}</a>`)
  .join("");
const flagHtml = flagValue ? `<section class="writeup-flag"><h2>FLAG CAPTURED</h2><p class="ctf-flag">${escapeHtml(flagValue)}</p></section>` : "";
---
<ContentViewer
  title={`${title} · ${eventTitle} · Radiant Blaze`}
  description={description}
  canonical={`https://radiant-blaze.github.io${route}`}
  type="writeup"
  body={body}
  tocHtml={tocHtml}
  tocLabel="Writeup contents"
  relatedHtml={related}
  relatedLabel="Related writeups"
  flagHtml={flagHtml}
  layoutClass="writeup-layout"
  sidebarClass="writeup-sidebar"
  articleClass="writeup-article"
  sidebarLabel="Writeup navigation and challenge details"
>
  <nav slot="before" class="writeup-breadcrumb quest-wrap" aria-label="Breadcrumb"><a href={`/pages/ctf.html?${eventQuery}`}>CTF CHALLENGES</a><span aria-hidden="true">/</span><span>{eventTitle}</span></nav>
  <ContentHeader
    slot="header"
    title={title}
    description={description}
    headerClass="writeup-header"
    descriptionClass="writeup-description"
  >
    <p slot="eyebrow" class="writeup-event">{eventTitle}</p>
    <div slot="meta" class="writeup-meta" aria-label="Challenge details">
      <span class="writeup-category">{category}</span>
      <span><b>{pointsText}</b> points</span>
      <span><Fragment set:html={difficultyMeterHtml(difficulty)} /></span>
      {solvesValue && <span><b>{solvesValue}</b> solves</span>}
      <span>Published {formatDate(event.data.date)}</span>
      <span>By {author}</span>
    </div>
    {challengeTags.length > 0 && <nav slot="tags" class="writeup-tags" aria-label="Challenge tags" set:html={tagsForEvent} />}
  </ContentHeader>
</ContentViewer>
