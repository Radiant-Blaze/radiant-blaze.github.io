---
import { getOrderedArticles, type OrderedWriteup, writeupRoute } from "../../../../lib/article-data";
import { getWriteupPresentation } from "../../../../lib/article-metadata";
import ContentHeader from "../../../../components/content/ContentHeader.astro";
import ContentViewer from "../../../../components/content/ContentViewer.astro";
import { renderContentView, renderTocHtml } from "../../../../lib/content-view";
import { difficultyMeterHtml } from "../../../../lib/difficulty";
import { escapeHtml, formatDate } from "../../../../lib/markdown";
import { selectRelatedWriteups, type RelatedWriteup } from "../../../../lib/related-content";
import {
  articleEntity,
  breadcrumbEntity,
  isoDate,
  jsonLdGraph,
  personEntity,
  SITE_DESCRIPTION,
  webPageEntity,
  websiteEntity,
} from "../../../../lib/seo";

export async function getStaticPaths() {
  const { writeups } = await getOrderedArticles();
  const candidates: RelatedWriteup[] = writeups.map((writeup) => ({
    ctfId: writeup.ctfId,
    challengeFile: writeup.challengeFile,
    title: writeup.entry.data.title ?? writeup.challengeFile.replace(/\.md$/i, ""),
    category: writeup.entry.data.category,
    tags: writeup.entry.data.tags ?? [],
    eventTitle: writeup.event.data.title,
    date: writeup.event.data.date,
  }));
  return writeups.map((writeup: OrderedWriteup) => {
    const current = candidates.find(
      (candidate) => candidate.ctfId === writeup.ctfId && candidate.challengeFile === writeup.challengeFile,
    )!;
    const challengeNumber = writeup.challengeFiles.indexOf(writeup.challengeFile);
    const excluded = [writeup.challengeFiles[challengeNumber - 1], writeup.challengeFiles[challengeNumber + 1]]
      .filter((file): file is string => Boolean(file))
      .map((file) => ({ ctfId: writeup.ctfId, challengeFile: file }));
    return {
      params: {
        ctf: writeup.ctfId,
        challenge: writeup.challengeFile.replace(/\.md$/i, ""),
      },
      props: {
        ...writeup,
        eventChallengeFiles: writeup.challengeFiles,
        related: selectRelatedWriteups(current, candidates, { exclude: excluded }),
      },
    };
  });
}

const { ctfId, challengeFile, entry, event, eventChallengeFiles, related: relatedWriteups } = Astro.props;
const challenge = entry.data;
const eventTitle = event.data.title;
const {
  title,
  description,
  category,
  points: pointsText,
  difficulty,
  solves: solvesValue,
  flag: flagValue,
  tags: challengeTags,
  author,
} = getWriteupPresentation(challenge, challengeFile, eventTitle);
const route = writeupRoute(ctfId, challengeFile);
const url = `https://radiant-blaze.github.io${route}`;
// Keep the browser/SEO title inside the ~65-character guideline: long
// challenge plus event names drop the brand suffix instead of being truncated.
const eventScopedTitle = `${title} · ${eventTitle}`;
const brandedTitle = `${eventScopedTitle} · Radiant Blaze`;
const pageTitle = brandedTitle.length > 65 ? eventScopedTitle : brandedTitle;
const jsonLd = jsonLdGraph(
  personEntity(),
  websiteEntity(SITE_DESCRIPTION),
  webPageEntity({ name: title, description, url }),
  breadcrumbEntity([
    { name: "Home", path: "/" },
    { name: "CTF Writeups", path: "/pages/ctf.html" },
    { name: title, path: route },
  ]),
  articleEntity({
    type: "TechArticle",
    headline: title,
    description,
    url,
    datePublished: isoDate(event.data.date),
    articleSection: category,
    keywords: challengeTags,
  }),
);
const challengeNumber = eventChallengeFiles.indexOf(challengeFile);
const previous = eventChallengeFiles[challengeNumber - 1];
const following = eventChallengeFiles[challengeNumber + 1];
const eventQuery = new URLSearchParams({ ctf: ctfId }).toString();
const challengeUrl = (file: string) => writeupRoute(ctfId, file);
const { html: body, headings } = await renderContentView(entry.body ?? "");
const hasMermaid = body.includes('data-language="mermaid"');
const tocHtml = renderTocHtml(headings, "This writeup has no section headings.");
const related = `${previous ? `<a href="${challengeUrl(previous)}">← PREVIOUS CHALLENGE</a>` : "<span>FIRST CHALLENGE</span>"}<span>CHALLENGE ${challengeNumber + 1} / ${eventChallengeFiles.length}</span>${following ? `<a href="${challengeUrl(following)}">NEXT CHALLENGE →</a>` : "<span>LAST CHALLENGE</span>"}`;
const tagsForEvent = challengeTags
  .map((tag) => `<a href="/pages/ctf.html?${eventQuery}"># ${escapeHtml(tag)}</a>`)
  .join("");
const flagHtml = flagValue ? `<section class="writeup-flag"><h2>FLAG CAPTURED</h2><p class="ctf-flag">${escapeHtml(flagValue)}</p></section>` : "";
const relatedChallengesHtml = relatedWriteups.length > 0
  ? `<section class="related-challenges" aria-labelledby="related-challenges-title"><h2 id="related-challenges-title">RELATED CHALLENGES</h2><ul>${relatedWriteups.map((item) => `<li><a href="${writeupRoute(item.ctfId, item.challengeFile)}"><strong>${escapeHtml(item.title)}</strong><small>${escapeHtml(item.eventTitle)} · ${escapeHtml(item.category || "CTF")}</small></a></li>`).join("")}</ul></section>`
  : "";
---
<ContentViewer
  title={pageTitle}
  description={description}
  canonical={url}
  jsonLd={jsonLd}
  type="writeup"
  body={body}
  tocHtml={tocHtml}
  tocLabel="Writeup contents"
  relatedHtml={related}
  relatedChallengesHtml={relatedChallengesHtml}
  relatedLabel="Related writeups"
  flagHtml={flagHtml}
  layoutClass="writeup-layout"
  sidebarClass="writeup-sidebar"
  articleClass="writeup-article"
  sidebarLabel="Writeup navigation and challenge details"
  mermaid={hasMermaid}
>
  <nav slot="before" class="writeup-breadcrumb quest-wrap" aria-label="Breadcrumb"><a href={`/pages/ctf.html?${eventQuery}`}>CTF CHALLENGES</a><span aria-hidden="true">/</span><span>{eventTitle}</span></nav>
  <ContentHeader
    slot="header"
    title={title}
    description={description}
    headerClass="writeup-header"
    descriptionClass="writeup-description"
  >
    <p slot="eyebrow" class="writeup-event">{eventTitle}</p>
    <div slot="meta" class="writeup-meta" aria-label="Challenge details">
      <span class="writeup-category">{category}</span>
      <span><b>{pointsText}</b> points</span>
      <span><Fragment set:html={difficultyMeterHtml(difficulty)} /></span>
      {solvesValue && <span><b>{solvesValue}</b> solves</span>}
      <span>Published {formatDate(event.data.date)}</span>
      <span>By {author}</span>
    </div>
    {challengeTags.length > 0 && <nav slot="tags" class="writeup-tags" aria-label="Challenge tags" set:html={tagsForEvent} />}
  </ContentHeader>
</ContentViewer>
