---
import Footer from "../components/Footer.astro";
---
<!doctype html>
<html lang="en" class="dark-theme">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>404 — Game Over · Radiant Blaze</title>
    <meta name="theme-color" content="#171329" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/assets/fonts/press-start-2p-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/assets/css/style.css?v=20261002-15" />
    <script src="/assets/js/astro-controls.js" is:inline></script>
    <script src="/assets/js/page-loader.js" defer is:inline></script>
  </head>
  <body>
    <main class="game-screen">
      <header class="top-bar">
        <a class="pixel-logo" href="/" aria-label="Radiant Blaze home">RB</a>
        <div class="top-controls"><input class="theme-checkbox" id="theme-toggle-checkbox" type="checkbox" data-theme-toggle aria-label="Switch to light theme" /><label class="theme-switch" for="theme-toggle-checkbox" aria-hidden="true"><span class="theme-switch-thumb"><svg class="sun-icon" viewBox="0 0 16 16"><path d="M7 0h2v3H7zM7 13h2v3H7zM0 7h3v2H0zM13 7h3v2h-3zM2 2h2v2H2zM12 2h2v2h-2zM2 12h2v2H2zM12 12h2v2h-2zM5 5h6v6H5z" /></svg><svg class="moon-icon" viewBox="0 0 24 24"><path d="M19.8 15.1A9.4 9.4 0 0 1 8.9 4.2 9.6 9.6 0 1 0 19.8 15.1Z" /><path d="M17 3v4M15 5h4M6 2v3M4.5 3.5h3M20 9v3M18.5 10.5h3" /></svg></span></label></div>
      </header>
      <section class="hero" id="top">
        <div class="pixel-spark spark-one" aria-hidden="true"></div>
        <div class="pixel-spark spark-two" aria-hidden="true"></div>
        <p class="level-label">ERROR 404</p>
        <h1>GAME<br /><span>OVER</span></h1>
        <p class="hero-copy">This quest doesn't exist —<br />the page wandered off the map.</p>
        <a class="pixel-button cta-button" href="/">RETURN HOME <span aria-hidden="true">→</span></a>
      </section>
      <Footer simple />
    </main>
  </body>
</html>
