---
import { ASSET_VERSION } from "../lib/assets";
import ThemeBootstrap from "../components/ThemeBootstrap.astro";
import "../styles/style.css";
import { getHomepageProjection } from "../lib/home-data";
import { formatDate } from "../lib/markdown";
import Footer from "../components/Footer.astro";
import { jsonLdGraph, JSON_FEED_URL, personEntity, RSS_FEED_URL, serializeJsonLd, SITE_DESCRIPTION, websiteEntity } from "../lib/seo";

const { latestWriteup, latestPost, featuredProject } = await getHomepageProjection();
const feature = latestWriteup ?? latestPost ?? {
  type: "WRITEUP" as const,
  title: "Hackel",
  description: "Recover the flag by identifying a leaked one-bit classification rule from the training samples and decoding the resulting 496-bit stream as ASCII.",
  href: "/generated/writeups/ASIS-CTF-2026/Hackel.html",
  dateLabel: "AUG 29, 2026",
  category: "CRYPTO",
};
const featureDate = "dateLabel" in feature ? feature.dateLabel : formatDate(feature.date);
const pageTitle = "Radiant Blaze — CTF Writeups & Linux Field Notes";
const jsonLd = jsonLdGraph(personEntity(), websiteEntity(SITE_DESCRIPTION));
---
<!doctype html>
<html lang="en" class="dark-theme">
  <head>
    <meta charset="UTF-8" />
    <ThemeBootstrap />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={SITE_DESCRIPTION} />
    <title>{pageTitle}</title>
    <link rel="canonical" href="https://radiant-blaze.github.io/" />
    <meta name="theme-color" content="#171329" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" is:inline set:html={serializeJsonLd(jsonLd)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Radiant Blaze" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={SITE_DESCRIPTION} />
    <meta property="og:url" content="https://radiant-blaze.github.io/" />
    <meta property="og:image" content="https://radiant-blaze.github.io/og-image.png" />
    <meta property="og:image:alt" content="Radiant Blaze pixel-art city banner" />
    <meta property="og:image:width" content="1500" />
    <meta property="og:image:height" content="592" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={SITE_DESCRIPTION} />
    <meta name="twitter:image" content="https://radiant-blaze.github.io/og-image.png" />
    <meta name="twitter:image:alt" content="Radiant Blaze pixel-art city banner" />
    <link rel="alternate" type="application/rss+xml" title="Radiant Blaze — RSS feed" href={RSS_FEED_URL} />
    <link rel="alternate" type="application/feed+json" title="Radiant Blaze — JSON feed" href={JSON_FEED_URL} />
    <link rel="preload" href="/assets/fonts/press-start-2p-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/press-start/press-start-k.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/sf-pixelate/sf-pixelate-bold.woff2" as="font" type="font/woff2" crossorigin />
    <script src="../scripts/astro-controls.ts"></script>
    <script defer src={`/assets/js/music-controller.js?v=${ASSET_VERSION}`} is:inline></script>
    <script src="../scripts/page-loader.ts"></script>
    <script src="../scripts/astro-navigation.ts"></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">SKIP TO CONTENT</a>
    <main class="game-screen" id="main-content" tabindex="-1">
      <header class="top-bar site-header">
        <a class="home-brand" href="#top" aria-label="Radiant Blaze home" aria-current="page"><span class="pixel-logo">RB</span><span class="brand-copy"><span class="brand-title">RADIANT BLAZE</span><span class="brand-caption">PLAYER ONE / HOME BASE</span></span></a>
        <nav class="home-nav" id="primary-site-nav" aria-label="Site navigation"><a href="pages/blog.html" data-nav-index="01">BLOG</a><a href="pages/ctf.html" data-nav-index="02">CTFS</a><a href="pages/search.html" data-nav-index="03">SEARCH</a><a href="portfolio/" data-nav-index="04">PORTFOLIO</a></nav>
        <div class="top-controls">
          <input class="theme-checkbox" id="theme-toggle-checkbox" type="checkbox" data-theme-toggle aria-label="Switch to light theme" />
          <label class="theme-switch" for="theme-toggle-checkbox" aria-hidden="true"><span class="theme-switch-thumb"><svg class="sun-icon" viewBox="0 0 16 16"><path d="M7 0h2v3H7zM7 13h2v3H7zM0 7h3v2H0zM13 7h3v2h-3zM2 2h2v2H2zM12 2h2v2h-2zM2 12h2v2H2zM12 12h2v2h-2zM5 5h6v6H5z" /></svg><svg class="moon-icon" viewBox="0 0 24 24"><path d="M19.8 15.1A9.4 9.4 0 0 1 8.9 4.2 9.6 9.6 0 1 0 19.8 15.1Z" /><path d="M17 3v4M15 5h4M6 2v3M4.5 3.5h3M20 9v3M18.5 10.5h3" /></svg></span></label>
          <button class="mobile-menu-toggle" data-mobile-menu-toggle type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="primary-site-nav">
            <span class="menu-wrapper" aria-hidden="true">
              <span class="menu-row menu-row-top"><span class="menu-dot"></span><span class="menu-dot"></span></span>
              <span class="menu-row menu-row-bottom"><span class="menu-dot"></span><span class="menu-dot"></span></span>
              <span class="menu-row menu-row-horizontal"><span class="menu-dot"></span><span class="menu-dot menu-dot-horizontal"></span><span class="menu-dot"></span></span>
              <span class="menu-row menu-row-vertical"><span class="menu-dot"></span><span class="menu-dot menu-dot-vertical"></span><span class="menu-dot"></span></span>
            </span>
          </button>
        </div>
      </header>
      <section class="hero" id="top">
        <div class="pixel-spark spark-one" aria-hidden="true"></div>
        <div class="pixel-spark spark-two" aria-hidden="true"></div>
        <p class="level-label">TALHA AHMED PRESENTS</p>
        <h1>BLAZE'S<br /><span>BLOGPOST</span></h1>
        <p class="hero-copy">A tiny corner of the internet<br />made with big pixels and bright ideas.</p>
        <p class="hero-role">Software development · cybersecurity · CTF field notes</p>
      </section>
      <section class="status-panel" id="start" aria-label="Useful next steps">
        <div class="status-panel-header">
          <div class="status-status"><span class="status-light" aria-hidden="true"></span><span class="panel-title">LIVE LOADOUT</span></div>
          <div class="hero-actions status-panel-actions">
            <a class="pixel-button start-button" href={feature.href}>READ LATEST {feature.type}</a>
            <a class="pixel-button" href="pages/ctf.html">EXPLORE CTFS</a>
            <a class="pixel-button" href="portfolio/">VIEW PORTFOLIO</a>
          </div>
          <span class="loading-dots" aria-hidden="true">→</span>
        </div>
        <div class="status-panel-grid">
          <a class="feature-tile feature-tile--primary" href={feature.href} data-latest-post aria-label={`Read the latest ${feature.type.toLowerCase()}: ${feature.title}`}><p class="quest-number">LATEST {feature.type}</p><h2>{feature.title}</h2><p>{feature.description}</p><div class="quest-meta"><span>{featureDate}</span><span><b>{feature.category.toUpperCase()}</b></span></div></a>
          {latestPost && <a class="feature-tile" href={latestPost.href} aria-label={`Read the latest post: ${latestPost.title}`}><p class="quest-number">LATEST POST</p><h2>{latestPost.title}</h2><p>{latestPost.description}</p><div class="quest-meta"><span>{formatDate(latestPost.date)}</span><span><b>{latestPost.category.toUpperCase()}</b></span></div></a>}
          <a class="feature-tile" href="pages/search.html" aria-label="Search the archive"><p class="quest-number">SEARCH ARCHIVE</p><h2>Search the archive</h2><p>Browse every post, writeup, and tag in one place to find the exact material you need.</p><div class="quest-meta"><span>NOW</span><span><b>DISCOVER</b></span></div></a>
        </div>
      </section>
      {featuredProject && (
        <section class="home-project quest-wrap" aria-labelledby="home-project-title">
          <div class="home-project-heading">
            <p class="eyebrow">SELECTED WORK · FROM THE PORTFOLIO</p>
            <a class="home-project-all" href="portfolio/">ALL PROJECTS →</a>
          </div>
          <a class="home-project-card" href={featuredProject.href} aria-label={`View project: ${featuredProject.title}`}>
            <p class="quest-number">PROJECT · {featuredProject.category.toUpperCase()}</p>
            <h2 id="home-project-title">{featuredProject.title}</h2>
            <p>{featuredProject.description}</p>
            {featuredProject.technologies.length > 0 && (
              <ul class="home-project-tech" aria-label="Technologies">
                {featuredProject.technologies.slice(0, 6).map((technology) => <li>{technology}</li>)}
              </ul>
            )}
            <span class="home-project-action">VIEW PROJECT <span aria-hidden="true">→</span></span>
          </a>
        </section>
      )}
      <Footer home />
    </main>
  </body>
</html>
